<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/md3_primary_neon_bg">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape>
                    <solid android:color="@color/auto_apps_row_background" />
                    <stroke android:width="1dp" android:color="@color/md3_primary" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/md3_surface" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape><solid android:color="@color/white" /><corners android:radius="12dp" /></shape>
    </item>
</ripple>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hitbox_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md3_background">

    <com.quyetgd.keyvieweroverlay.AutoHitboxPreviewView
        android:id="@+id/auto_hitbox_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:contentDescription="@string/hitbox_auto_preview_description" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hitbox_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        app:cardBackgroundColor="@color/md3_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hitbox_editor_title"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/hitbox_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="220dp"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:accessibilityLiveRegion="none" />
            </LinearLayout>
            <RadioGroup
                android:id="@+id/hitbox_mode_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/radio_hitbox_custom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/hitbox_mode_custom"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
                <RadioButton
                    android:id="@+id/radio_hitbox_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hitbox_mode_auto"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </RadioGroup>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetHitbox"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/reset_default"
                android:textSize="12sp"
                app:cornerRadius="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveHitbox"
                style="@style/CompactNeonButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/save"
                android:textSize="12sp"
                app:cornerRadius="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseHitbox"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/hitbox_editor_close"
                android:text="×"
                android:textSize="22sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#181818"
        android:orientation="horizontal">
        <com.quyetgd.keyvieweroverlay.ThemePreviewView
            android:id="@+id/themePreview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:clickable="false"
            android:focusable="false" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="#262626"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/themeTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:tabIndicatorColor="#A78BFA"
                app:tabSelectedTextColor="#FFFFFF"
                app:tabTextColor="#99FFFFFF" />
            <ScrollView
                android:id="@+id/themeEditorScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="false">
                <LinearLayout
                    android:id="@+id/themeEditorHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                android:paddingBottom="28dp"
                android:background="#242424" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnThemeBack"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#454545"
        android:text="@string/color_cancel"
        android:textAllCaps="false"
        android:textColor="#D32F2F"
        app:cornerRadius="24dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnThemeSave"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:text="@string/save"
        android:textAllCaps="false"
        app:cornerRadius="24dp" />
</FrameLayout>

    <!-- Accessibility Prompt -->
    <string name="accessibility_requirement_title">需要无障碍服务权限</string>
    <string name="accessibility_requirement_desc">为什么 Key Viewer 需要此权限？\n\n系统（尤其是 Game Turbo）检测到游戏上方有全屏悬浮层时，通常会自动阻止触摸穿透。\n\n为了实时流畅地绘制\'触摸点\'，并让你无延迟地穿透悬浮层进行触控，应用需要使用无障碍服务的显示权限。\n\n🔒 隐私承诺：\n应用不会读取屏幕内容，也不会收集个人数据。此权限仅用于绘制触摸点图形。</string>
    <string name="grant_permission_now">立即授权</string>
    <string name="go_back">返回</string>

